{
  "name": "proofforge",
  "version": "1.0.0",
  "description": "ProofForge — AI Engineering Verification Framework. Evidence-driven engineering rules, verification, security, grounding, and quality gates for AI-assisted software development.",
  "main": "bin/webforge.js",
  "bin": {
    "proofforge": "./bin/webforge.js",
    "webforge": "./bin/webforge.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node bin/webforge.js test",
    "test:e2e": "node --test tests/e2e/server_app.test.js",
    "test:security": "node packages/security/tests/security.test.js",
    "test:contracts": "node packages/contracts/tests/contracts.test.js",
    "test:components": "node packages/components/tests/components.test.js",
    "test:design": "node packages/design-system/tests/design_system.test.js",
    "test:infra": "node packages/infrastructure/tests/infra.test.js",
    "test:smoke": "node tests/smoke/critical_flows_smoke.test.js",
    "serve": "node bin/webforge.js serve",
    "migrate": "node bin/webforge.js migrate",
    "verify": "node bin/webforge.js verify",
    "security": "node bin/webforge.js security",
    "proofforge": "node bin/webforge.js proofforge",
    "integrity": "node tests/integrity_test.js"
  },
  "keywords": [
    "proofforge",
    "ai-engineering",
    "verification-framework",
    "evidence-graph",
    "grounding-gate",
    "security",
    "asvs",
    "quality-gates",
    "anti-slop"
  ],
  "author": "ProofForge Architecture Team",
  "license": "MIT"
}
