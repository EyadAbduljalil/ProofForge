          "OWASP_ASVS_CHECKER",
          "INJECTION_DETECTOR"
        ],
        "validation_requirements": [
          "SECURITY_REGRESSION_SCAN",
          "STATIC_ANALYSIS"
        ],
        "verification_requirements": [
          "CVGF_GROUNDING_GATE",
          "CVGF_CLAIM_VERIFICATION"
        ],
        "required_evidence": [
          "VULNERABILITY_PROOF_OF_CONCEPT",
          "SECURITY_FINDINGS_REGISTER",
          "ASVS_L2_COMPLIANCE_PROOF"
        ],
        "evidence_schema": {
          "evidence_type": "SECURITY_FINDING",
          "severity_levels": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
          "reproducible": true
